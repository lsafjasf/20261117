{
  "name": "diving-bell-coop",
  "version": "1.0.0",
  "description": "双人协作潜水钟：共享状态、职责隔离、回放与保护状态",
  "private": true,
  "scripts": {
    "test": "node tests/run-tests.js",
    "test:browser": "node tests/browser-smoke.js",
    "serve": "node -e \"const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,r)=>{const u=q.url==='/'?'/index.html':q.url;const fp=p.join(process.cwd(),u);f.readFile(fp,(e,d)=>{if(e){r.writeHead(404);return r.end('404')}r.end(d)})}).listen(8080,()=>console.log('http://localhost:8080'))\""
  },
  "keywords": ["canvas", "coop", "game", "replay"],
  "license": "MIT"
}
