{
  "name": "lunar-low-gravity-rover",
  "version": "1.0.0",
  "description": "低重力月球运输车：向三个温室舱运送水箱与种子，固定 seed 可复现，含暂停/重开/检查点/存档",
  "private": true,
  "scripts": {
    "test": "node --test test/engine.test.js test/browser.smoke.js",
    "start": "node --eval \"const http=require('http'),fs=require('fs'),p=require('path');const t={'.html':'text/html','.js':'text/javascript','.css':'text/css'};http.createServer((q,r)=>{const f=p.join(process.cwd(),q.url==='/'?'index.html':q.url);fs.readFile(f,(e,d)=>{if(e){r.writeHead(404);return r.end('404')}r.writeHead(200,{'Content-Type':t[p.extname(f)]||'text/plain'});r.end(d)})}).listen(8080,()=>console.log('http://localhost:8080'))\""
  },
  "keywords": ["canvas", "game", "seeded", "lunar", "rover"],
  "license": "MIT"
}
